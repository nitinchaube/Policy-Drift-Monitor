# secrets - this repo is public
.env
.env.*
!.env.example
*.key

# python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# node
node_modules/
dist/
.vite/


# os
.DS_Store

# note: backend/cache/ is deliberately NOT ignored.
# the cached model responses are committed so the demo
# is reproducible offline and during the video recording.

# Source PDFs are NOT redistributed. Every CMS coverage document carries an AMA CPT
# copyright notice in its code-list sections, and the ADA guideline is ADA copyright.
# data/extracted/ holds the coverage-criteria prose instead: CMS government work,
# verified CPT-free. See backend/data/pdfs/README.md to retrieve the originals.
backend/data/pdfs/*.pdf

# Office lock files created when a doc/deck is open
~$*.docx
~$*.pptx
*.pdf.tmp

# LaTeX build artifacts, in case the report is rebuilt from source later
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
